---
import Base from "../layouts/Base.astro";
---

<Base titre="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="erreur on-ink">
    <div class="wrap">
      <p class="code">404</p>
      <h1 class="t-h1">Balle perdue.</h1>
      <p class="lede">
        Cette page n'existe pas, ou plus. Reprenons depuis le rond central.
      </p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Retour à l'accueil</a>
        <a href="/formations" class="btn btn-ghost">Voir les formations</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .erreur { display: grid; align-content: center; min-height: 76svh; padding-block: var(--s24); }
  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 9rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--accent);
    margin-bottom: var(--s4);
  }
  .lede { margin-block: var(--s4) var(--s8); max-width: 44ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s3); }
</style>

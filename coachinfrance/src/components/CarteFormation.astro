---
import Fleche from "./Fleche.astro";

interface Props {
  href: string;
  titre: string;
  accroche: string;
  niveau?: string;
  duree?: string;
  rythme?: string;
  visuel?: string;
  alt?: string;
}

const { href, titre, accroche, niveau, duree, rythme, visuel, alt } = Astro.props;
const meta = [niveau, duree, rythme].filter(Boolean) as string[];
---

<article class="carte-formation">
  <a href={href}>
    <div class="visuel">
      {visuel
        ? <img src={visuel} alt={alt ?? ""} loading="lazy" decoding="async" width="700" height="440" />
        : <div class="visuel-vide" aria-hidden="true"></div>}
    </div>
    <div class="corps">
      <h3 class="t-h3">{titre}</h3>
      <p>{accroche}</p>
      {meta.length > 0 && (
        <ul class="meta">
          {meta.map((m) => <li>{m}</li>)}
        </ul>
      )}
      <span class="link-arrow">Voir la formation <Fleche /></span>
    </div>
  </a>
</article>

<style>
  .carte-formation {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper);
    box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .carte-formation:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
  .carte-formation a { display: block; text-decoration: none; color: inherit; height: 100%; }

  .visuel { aspect-ratio: 16 / 9; overflow: hidden; background: var(--ink-700); }
  .visuel img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .carte-formation:hover .visuel img { transform: scale(1.05); }
  .visuel-vide {
    height: 100%;
    background:
      radial-gradient(120% 90% at 20% 10%, rgba(0,228,122,0.35), transparent 60%),
      linear-gradient(140deg, var(--ink-800), var(--ink-600));
  }

  .corps { display: grid; gap: var(--s3); padding: var(--s6); }
  .corps p { margin: 0; color: var(--text-soft); font-size: 0.9375rem; }

  .meta { display: flex; flex-wrap: wrap; gap: var(--s2); list-style: none; margin: 0; padding: 0; }
  .meta li {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-soft);
  }
</style>
